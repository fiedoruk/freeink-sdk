diff --git a/src/util/TlsProbeConfig.h b/src/util/TlsProbeConfig.h
new file mode 100644
index 0000000..df59084
--- /dev/null
+++ b/src/util/TlsProbeConfig.h
@@ -0,0 +1,69 @@
+#pragma once
+#include <cerrno>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+namespace tlsmemoryprobe {
+enum class Context { EarlyBoot, ReaderUi };
+struct Config {
+  Context context = Context::EarlyBoot;
+  char host[64] = {};
+  char ssid[33] = {};
+  char password[65] = {};
+  uint32_t epoch = 0;
+  uint16_t ports[5] = {};
+  uint16_t seen = 0;
+};
+inline bool parseLine(Config& config, char* line) {
+  const char* keys[] = {"context", "host", "ssid", "password", "epoch", "tls12", "tls13", "wronghost", "stall", "drop"};
+  char* equal = strchr(line, '=');
+  if (!equal) return false;
+  *equal = '\0';
+  const char* value = equal + 1;
+  for (const char* p = value; *p; ++p)
+    if (static_cast<unsigned char>(*p) < 32) return false;
+  unsigned index = 0;
+  while (index < 10 && strcmp(line, keys[index]) != 0) ++index;
+  if (index == 10 || (config.seen & (1U << index))) return false;
+  if (index == 0) {
+    if (strcmp(value, "early_boot") == 0)
+      config.context = Context::EarlyBoot;
+    else if (strcmp(value, "reader_ui") == 0)
+      config.context = Context::ReaderUi;
+    else
+      return false;
+  } else if (index < 4) {
+    char* destination = index == 1 ? config.host : index == 2 ? config.ssid : config.password;
+    const size_t capacity = index == 1   ? sizeof(config.host)
+                            : index == 2 ? sizeof(config.ssid)
+                                         : sizeof(config.password);
+    if (strlen(value) >= capacity || (index != 3 && !*value)) return false;
+    if (index == 1)
+      for (const char* p = value; *p; ++p) {
+        const bool allowed =
+            (*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') || (*p >= '0' && *p <= '9') || *p == '.' || *p == '-';
+        if (!allowed) return false;
+      }
+    strcpy(destination, value);
+  } else {
+    if (!*value) return false;
+    for (const char* p = value; *p; ++p)
+      if (*p < '0' || *p > '9') return false;
+    errno = 0;
+    char* end = nullptr;
+    const unsigned long number = strtoul(value, &end, 10);
+    if (errno || *end) return false;
+    if (index == 4) {
+      if (number < 1670000000UL || number > 2147483647UL) return false;
+      config.epoch = number;
+    } else {
+      if (number == 0 || number > 65535) return false;
+      config.ports[index - 5] = number;
+    }
+  }
+  config.seen |= 1U << index;
+  return true;
+}
+inline bool complete(const Config& config) { return config.seen == 1023; }
+}  // namespace tlsmemoryprobe
diff --git a/src/util/TlsProbeWindow.h b/src/util/TlsProbeWindow.h
new file mode 100644
index 0000000..4147541
--- /dev/null
+++ b/src/util/TlsProbeWindow.h
@@ -0,0 +1,22 @@
+#pragma once
+#include <esp_heap_caps.h>
+namespace tlsmemoryprobe {
+class HeapWindow {
+ public:
+  HeapWindow() : startResult(heap_caps_monitor_local_minimum_free_size_start()) {}
+  ~HeapWindow() { finish(); }
+  HeapWindow(const HeapWindow&) = delete;
+  HeapWindow& operator=(const HeapWindow&) = delete;
+  bool owned() const { return startResult == ESP_OK; }
+  void finish() {
+    if (!owned() || stopCalled) return;
+    minimum = heap_caps_get_minimum_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
+    stopResult = heap_caps_monitor_local_minimum_free_size_stop();
+    stopCalled = true;
+  }
+  const esp_err_t startResult;
+  esp_err_t stopResult = ESP_FAIL;
+  bool stopCalled = false;
+  size_t minimum = 0;
+};
+}  // namespace tlsmemoryprobe
